			<?php else: ?>
				<kbd><?= htmlspecialchars($callback->url(), ENT_COMPAT, 'UTF-8') ?></kbd>
				<?php if (!Minz_Request::serverIsPublic($callback->url())): ?>
					<p class="alert alert-warn"><?= _t('ext.rsscloud.callback.private') ?></p>
				<?php endif; ?>
			<?php endif; ?>
			<p class="help"><?= _i('help') ?> <?= _t('ext.rsscloud.callback.help') ?></p>
		</div>
	</div>

